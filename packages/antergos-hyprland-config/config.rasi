configuration {
    modi: [drun,run,window];
    font: "JetBrains Mono 12";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "kitty";
    location: 0;
    sidebar-mode: true;
    matching: "fuzzy";
    sorting-method: "fzf";
    display-drun: " Apps ";
    display-run: " Run ";
    display-window: " Windows ";
}

@theme "~/.config/rofi/theme.rasi"
