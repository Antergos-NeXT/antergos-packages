[global]
    font = JetBrains Mono Nerd Font 10
    follow = mouse
    width = 350
    height = 120
    offset = 10x48
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#4A9EFF"
    separator_color = frame
    sort = yes
    idle_threshold = 120
    markup = full
    alignment = left
    word_wrap = yes
    show_indicators = yes
    icon_path = /usr/share/icons/Papirus/16x16/status/
    corner_radius = 8
    timeout = 5

[urgency_low]
    background = "#20252B"
    foreground = "#E3E2E6"
    frame_color = "#676E7D"

[urgency_normal]
    background = "#20252B"
    foreground = "#E3E2E6"
    frame_color = "#4A9EFF"

[urgency_critical]
    background = "#20252B"
    foreground = "#FF5555"
    frame_color = "#FF5555"
